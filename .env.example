# Copy to .env.local. Every variable is optional: with none set the app runs fully offline
# (embedded PGlite database, synthetic model, local file storage, dev-only session secret).

# --- Auth (required in production: min 16 chars; generate with `openssl rand -hex 32`) ---
SESSION_SECRET=

# --- Database: leave empty to use embedded PGlite (.data/pglite) ---
DATABASE_URL=
# Run drizzle migrations on boot against DATABASE_URL (otherwise use `npm run db:migrate`)
AUTO_MIGRATE=
# Seed fictional demo data when the users table is empty (always on for PGlite)
DEMO_SEED=

# --- Model provider: synthetic (default) | anthropic | bedrock ---
MODEL_PROVIDER=synthetic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# --- Storage, links, retention ---
STORAGE_DIR=            # default .data/files (in-memory on Vercel unless an S3-style adapter is wired)
DOWNLOAD_LINK_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760
RETENTION_DAYS=365
FIXTURES_DIR=           # where the synthetic OCR adapter looks for <file>.ocr.txt sidecars
